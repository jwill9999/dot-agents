{
  "version": 1,
  "_comment": "Shared MCP definitions. Each server has ONE route: gateway (Docker MCP gateway profile), direct (written into each tool), or connector (the tool's own built-in connection). No secrets here: use bearer_env / env_refs with environment variable names.",
  "gateway": {
    "name": "MCP_DOCKER",
    "profile": "codex",
    "command": "docker",
    "args": [
      "mcp",
      "gateway",
      "run",
      "--profile",
      "codex"
    ],
    "profile_file": "docker-profile-dev.yaml"
  },
  "servers": {
    "github": {
      "route": "gateway",
      "aliases": [
        "GitHub",
        "github-official"
      ],
      "match_urls": [
        "api.githubcopilot.com"
      ],
      "connector_in": [
        "codex"
      ],
      "note": "Docker 'codex' profile as github-official (OAuth in Docker Desktop); Codex uses its curated GitHub connection instead."
    },
    "context7": {
      "route": "gateway",
      "match_urls": [
        "mcp.context7.com"
      ],
      "note": "In the Docker 'codex' profile."
    },
    "figma": {
      "route": "direct",
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "note": "Remote, OAuth sign-in per tool."
    },
    "beads": {
      "route": "direct",
      "type": "stdio",
      "command": "~/.local/bin/beads-mcp",
      "args": [],
      "match_commands": [
        "beads-mcp"
      ],
      "note": "Needs the local repo; pass workspace_root per call. No global cwd."
    },
    "chrome-devtools": {
      "route": "direct",
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics"
      ],
      "note": "Drives the local Chrome."
    },
    "playwright": {
      "route": "gateway",
      "match_commands": [
        "@playwright/mcp"
      ],
      "note": "Docker 'codex' profile (containerised, headless)."
    },
    "notebooklm": {
      "route": "direct",
      "type": "stdio",
      "command": "notebooklm-mcp",
      "args": [],
      "aliases": [
        "notebooklm-mcp"
      ],
      "note": "Local CLI with its own sign-in."
    },
    "sonarqube": {
      "route": "gateway",
      "note": "Docker 'codex' profile; token in Docker's secret store."
    },
    "fetch": {
      "route": "gateway",
      "note": "Docker 'codex' profile."
    },
    "time": {
      "route": "gateway",
      "note": "Docker 'codex' profile."
    },
    "sequentialthinking": {
      "route": "gateway",
      "note": "Docker 'codex' profile.",
      "aliases": [
        "sequential-thinking"
      ]
    },
    "openapi": {
      "route": "gateway",
      "note": "Docker 'codex' profile."
    },
    "next-devtools-mcp": {
      "route": "gateway",
      "note": "Docker 'codex' profile (Next.js)."
    },
    "langchain_docs": {
      "route": "direct",
      "type": "http",
      "url": "https://docs.langchain.com/mcp",
      "aliases": [
        "docs-langchain",
        "langchain-docs"
      ],
      "match_urls": [
        "https://docs.langchain.com/mcp"
      ]
    },
    "langchain_reference": {
      "route": "direct",
      "type": "http",
      "url": "https://reference.langchain.com/mcp",
      "aliases": [
        "reference-langchain",
        "langchain-reference"
      ],
      "match_urls": [
        "https://reference.langchain.com/mcp"
      ]
    },
    "mastra": {
      "route": "direct",
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mastra/mcp-docs-server@latest"
      ],
      "aliases": [
        "mastra-docs"
      ],
      "match_commands": [
        "@mastra/mcp-docs-server"
      ],
      "note": "Mastra docs, examples and changelogs (local stdio, no credentials). Needs Node >=22.13. Hosted alternative https://mastra.mcp.kapa.ai needs Google sign-in."
    },
    "langfuse-docs": {
      "route": "direct",
      "type": "http",
      "url": "https://langfuse.com/api/mcp",
      "match_urls": [
        "langfuse.com/api/mcp"
      ],
      "note": "Public Langfuse docs search, no credentials. https://langfuse.com/docs/docs-mcp"
    },
    "langfuse": {
      "route": "direct",
      "type": "http",
      "url": "https://cloud.langfuse.com/api/public/mcp",
      "headers_env": {
        "Authorization": "LANGFUSE_MCP_AUTH"
      },
      "disabled_tools": [
        "deleteAnnotationQueueItem",
        "deleteAnnotationQueueAssignment",
        "deleteDatasetItem",
        "deleteDatasetRun",
        "deleteScoreConfig",
        "deleteModel",
        "deleteEvaluator",
        "deleteEvaluationRule",
        "deleteDashboardWidget",
        "deleteDashboard",
        "deleteDashboardPlacement",
        "updatePromptLabels",
        "runBatchEvaluation",
        "testEvaluator",
        "submitFeedback"
      ],
      "match_urls": [
        "/api/public/mcp"
      ],
      "tool_overrides": {
        "gemini": {
          "type": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "mcp-remote@latest",
            "https://cloud.langfuse.com/api/public/mcp",
            "--header",
            "Authorization:${LANGFUSE_AUTH_HEADER}"
          ],
          "env_refs": {
            "LANGFUSE_AUTH_HEADER": "LANGFUSE_MCP_AUTH"
          }
        }
      },
      "note": "Langfuse project MCP (prompts, traces, observations). disabled_tools blocks deletes, prompt label moves, evaluation runs and external feedback: Codex disabled_tools, Gemini excludeTools, Claude Code permissions.deny, Cursor per-tool toggles (UI only). Project-scoped keys from the Keychain via ~/.agents/env/langfuse.sh, which exports LANGFUSE_MCP_AUTH='Basic base64(pk:sk)'. Codex: hand-written env_http_headers in config.toml. Gemini: via mcp-remote, since header env expansion is undocumented there. https://langfuse.com/docs/api-and-data-platform/features/mcp-server"
    }
  },
  "tools": {
    "codex": {
      "skip": []
    },
    "claude": {
      "skip": []
    },
    "cursor": {
      "skip": []
    },
    "gemini": {
      "skip": []
    }
  }
}
